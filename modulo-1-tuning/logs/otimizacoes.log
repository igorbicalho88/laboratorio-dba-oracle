  2    PARTITION BY RANGE (data_pedido) INTERVAL (NUMTOYMINTERVAL(1, 'MONTH'))
  3    (PARTITION p_2023_01 VALUES LESS THAN (DATE '2023-02-01'))
  4    ONLINE UPDATE INDEXES;

