SQL> -- 2) Mudanças nas regras de acesso: usuários, papéis, privilégios e políticas de segurança
SQL> CREATE AUDIT POLICY lgpd_mudancas_seguranca
  2    ACTIONS CREATE USER, ALTER USER, DROP USER, CREATE ROLE, DROP ROLE, GRANT, REVOKE,
  3  	       CREATE PROFILE, ALTER PROFILE,
  4  	       EXECUTE ON sys.dbms_redact, EXECUTE ON sys.dbms_rls;
          EXECUTE ON sys.dbms_redact, EXECUTE ON sys.dbms_rls
                         *
ERROR at line 4:
ORA-46358: Audit policy LGPD_MUDANCAS_SEGURANCA already exists.
Help: https://docs.oracle.com/error-help/db/ora-46358/


SQL> AUDIT POLICY lgpd_mudancas_seguranca;

Audit succeeded.

SQL> 
SQL> -- 3) Tentativas de login com falha (política pronta do Oracle)
SQL> AUDIT POLICY ora_logon_failures WHENEVER NOT SUCCESSFUL;

Audit succeeded.

SQL> 
SQL> COLUMN policy_name FORMAT A30
SQL> COLUMN entity_name FORMAT A12
SQL> SELECT policy_name, enabled_option, entity_name, entity_type, success, failure
  2    FROM audit_unified_enabled_policies
  3   WHERE policy_name LIKE 'LGPD%' OR policy_name = 'ORA_LOGON_FAILURES'
  4   ORDER BY 1;

