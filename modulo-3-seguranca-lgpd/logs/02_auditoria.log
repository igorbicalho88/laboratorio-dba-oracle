SQL> -- 1) Quem leu ou alterou dados pessoais (exceto a aplicação, que geraria volume enorme)
SQL> CREATE AUDIT POLICY lgpd_acesso_dados_pessoais
  2    ACTIONS SELECT ON lab.clientes, UPDATE ON lab.clientes, DELETE ON lab.clientes,
  3  	       SELECT ON lab.vw_clientes_analise;
  ACTIONS SELECT ON lab.clientes, UPDATE ON lab.clientes, DELETE ON lab.clientes,
                        *
