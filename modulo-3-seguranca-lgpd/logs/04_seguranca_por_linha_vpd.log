SQL> GRANT SELECT ON lab.clientes TO seg_admin;

Grant succeeded.

SQL> 
SQL> -- Função que monta o filtro. Atendente sem região cadastrada não vê nada.
SQL> CREATE OR REPLACE FUNCTION seg_admin.filtro_por_uf (p_esquema VARCHAR2, p_objeto VARCHAR2)
  2    RETURN VARCHAR2
  3  AS
  4    v_atendente NUMBER;
  5    v_uf	   seg_admin.acesso_regional.uf%TYPE;
  6  BEGIN
  7    SELECT COUNT(*) INTO v_atendente FROM sys.dba_role_privs
  8  	WHERE grantee = SYS_CONTEXT('USERENV', 'SESSION_USER') AND granted_role = 'ATENDIMENTO'
  9  	  AND admin_option = 'NO';   -- quem criou o papel (SYS) também o recebe, com ADMIN OPTION
 10    IF v_atendente = 0 THEN
 11  	 RETURN NULL;
 12    END IF;
 13    SELECT uf INTO v_uf FROM seg_admin.acesso_regional
 14  	WHERE usuario = SYS_CONTEXT('USERENV', 'SESSION_USER');
 15    IF p_objeto = 'CLIENTES' THEN
 16  	 RETURN 'uf = ''' || v_uf || '''';
 17    ELSE
 18  	 RETURN 'cliente_id IN (SELECT cliente_id FROM lab.clientes WHERE uf = ''' || v_uf || ''')';
 19    END IF;
 20  EXCEPTION
 21    WHEN NO_DATA_FOUND THEN RETURN '1 = 0';
 22  END;
 23  /

Function created.

SQL> SHOW ERRORS FUNCTION seg_admin.filtro_por_uf
