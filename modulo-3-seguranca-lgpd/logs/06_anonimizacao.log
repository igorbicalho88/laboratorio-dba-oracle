SQL> -- Registro de cada solicitação atendida (prova de cumprimento, sem dado pessoal)
SQL> CREATE TABLE seg_admin.solicitacoes_titular (
  2    protocolo     VARCHAR2(20) CONSTRAINT pk_solicitacoes PRIMARY KEY,
  3    cliente_id    NUMBER	  NOT NULL,
  4    tipo	     VARCHAR2(20) NOT NULL,
  5    atendida_em   TIMESTAMP	  DEFAULT SYSTIMESTAMP NOT NULL,
  6    executada_por VARCHAR2(128) DEFAULT SYS_CONTEXT('USERENV', 'SESSION_USER') NOT NULL
  7  );

Table created.

SQL> 
SQL> -- SELECT também é exigido: o UPDATE filtra por cliente_id (SQL92_SECURITY)
SQL> GRANT SELECT, UPDATE ON lab.clientes TO seg_admin;

Grant succeeded.

SQL> 
SQL> CREATE OR REPLACE PROCEDURE seg_admin.anonimizar_cliente (p_cliente_id NUMBER, p_protocolo VARCHAR2)
  2  AS
  3  BEGIN
  4    UPDATE lab.clientes
  5  	  SET nome  = 'Titular anonimizado',
  6  	      cpf   = 'X' || LPAD(p_cliente_id, 10, '0'),   -- continua único, mas não é um CPF
  7  	      email = NULL
  8  	WHERE cliente_id = p_cliente_id;
  9    IF SQL%ROWCOUNT = 0 THEN
 10  	 RAISE_APPLICATION_ERROR(-20001, 'Cliente ' || p_cliente_id || ' nao encontrado');
 11    END IF;
 12    INSERT INTO seg_admin.solicitacoes_titular (protocolo, cliente_id, tipo)
 13    VALUES (p_protocolo, p_cliente_id, 'ELIMINACAO');
 14    COMMIT;
 15  END;
 16  /

Procedure created.

SQL> SHOW ERRORS PROCEDURE seg_admin.anonimizar_cliente
No errors.
