SQL> -- Política de senhas: bloqueio após 5 erros, troca a cada 90 dias, sem repetir as 5 últimas
SQL> CREATE PROFILE perfil_lgpd LIMIT
  2    FAILED_LOGIN_ATTEMPTS	5
  3    PASSWORD_LOCK_TIME	1/24
  4    PASSWORD_LIFE_TIME	90
  5    PASSWORD_GRACE_TIME	7
  6    PASSWORD_REUSE_MAX	5
  7    PASSWORD_REUSE_TIME	365
  8    INACTIVE_ACCOUNT_TIME	60
  9    PASSWORD_VERIFY_FUNCTION ora12c_verify_function;

Profile created.

