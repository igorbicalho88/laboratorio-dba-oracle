SQL> -- Esquema que guarda as regras de segurança: sem senha, ninguém faz login nele
SQL> CREATE USER seg_admin NO AUTHENTICATION DEFAULT TABLESPACE lab_dados QUOTA 10M ON lab_dados;

User created.

SQL> 
SQL> -- Papéis (roles) por função
SQL> -- (no SQL*Plus, comentário na mesma linha depois do ";" impede a execução: ficam sempre acima)
SQL> -- lgpd_dados_completos: marcador; quem tem este papel vê CPF e e-mail sem máscara
SQL> CREATE ROLE lgpd_dados_completos;

Role created.

SQL> -- app_loja_role: a aplicação da loja
SQL> CREATE ROLE app_loja_role;

Role created.

SQL> -- atendimento: só clientes da sua UF, com CPF e e-mail mascarados
SQL> CREATE ROLE atendimento;

Role created.

SQL> -- analista: BI, com pedidos e uma visão de clientes SEM dados pessoais
SQL> CREATE ROLE analista;

Role created.

