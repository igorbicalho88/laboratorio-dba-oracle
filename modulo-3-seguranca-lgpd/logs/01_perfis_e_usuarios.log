  3  		   FROM TABLE(sys.odcivarchar2list('APP_LOJA', 'ATEND_MG', 'ATEND_SP', 'ANALISTA_BI', 'AUDITOR_DPO'))) LOOP
  4  	 EXECUTE IMMEDIATE 'CREATE USER ' || u.nome || ' IDENTIFIED BY "&senha" PROFILE perfil_lgpd';
