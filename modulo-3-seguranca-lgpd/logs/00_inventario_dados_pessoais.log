SQL> -- Classificação de cada coluna com dado pessoal (art. 5º da LGPD)
SQL> ALTER TABLE lab.clientes MODIFY (
  2    nome  ANNOTATIONS (ADD dado_pessoal 'identificacao', finalidade 'atendimento e entrega', base_legal 'execucao de contrato'),
  3    cpf   ANNOTATIONS (ADD dado_pessoal 'identificador unico', finalidade 'emissao de nota fiscal', base_legal 'obrigacao legal', mascarar 'sim'),
  4    email ANNOTATIONS (ADD dado_pessoal 'contato', finalidade 'avisos do pedido', base_legal 'execucao de contrato', mascarar 'sim'),
  5    uf    ANNOTATIONS (ADD dado_pessoal 'localizacao (agregada)', finalidade 'logistica e analise', base_legal 'legitimo interesse')
  6  );

Table altered.

